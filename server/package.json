{
  "name": "earth-interactive-api",
  "private": true,
  "version": "0.1.0",
  "description": "Leaderboard + player-name API for EarthInteractive: self-hosted Node + SQLite, or Cloudflare Worker + D1",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning node/server.mjs",
    "backup": "node --disable-warning=ExperimentalWarning node/backup.mjs",
    "sql": "node --disable-warning=ExperimentalWarning node/sql.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create earth-interactive",
    "db:init:local": "wrangler d1 execute earth-interactive --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute earth-interactive --remote --file=schema.sql",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  },
  "engines": {
    "node": ">=22"
  }
}
