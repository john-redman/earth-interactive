# Copy to .env next to docker-compose.yml (Docker), or to server/.env / /etc/earth-api.env (systemd).
# Real environment variables override this file.

# The public name of the API. Point a DNS A record for it at the server first.
API_DOMAIN=api.example.com

# Sites allowed to call the API from a browser (comma-separated, exact origins, no trailing slash).
# capacitor://localhost and https://localhost are the iOS and Android app
ALLOWED_ORIGINS=https://john-redman.github.io,capacitor://localhost,https://localhost,http://localhost:5173,http://127.0.0.1:5173

# --- Only for running without Docker (systemd / npm start). Docker sets these itself. ---
# PORT=8787
# HOST=127.0.0.1
# DB_PATH=/var/lib/earth-api/earth.db
# TRUST_PROXY=1            # only when Caddy (or another proxy) is in front and the port is not public

# --- Optional ---
# RATE_WRITE_PER_MIN=10    # name + score posts per IP per minute (0 = off)
# RATE_READ_PER_MIN=120    # leaderboard + health reads per IP per minute (0 = off)
# BACKUP_DIR=              # default: <folder of DB_PATH>/backups
# BACKUP_KEEP=14
