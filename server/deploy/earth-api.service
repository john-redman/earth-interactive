# systemd unit for running the API without Docker. Install (see docs/backend.md → "Without Docker"):
#   sudo cp server/deploy/earth-api.service server/deploy/earth-api-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now earth-api earth-api-backup.timer
# Expects the repo at /opt/earth-interactive, settings in /etc/earth-api.env and a system user `earth`:
#   sudo useradd --system --home /var/lib/earth-api --shell /usr/sbin/nologin earth
[Unit]
Description=EarthInteractive API (Node + SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=earth
Group=earth
StateDirectory=earth-api
WorkingDirectory=/opt/earth-interactive/server
EnvironmentFile=/etc/earth-api.env
Environment=NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning
Environment=HOST=127.0.0.1 PORT=8787 DB_PATH=/var/lib/earth-api/earth.db TRUST_PROXY=1
ExecStart=/usr/bin/node node/server.mjs
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

# hardening: the service can only write its own state directory
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M

[Install]
WantedBy=multi-user.target
