{
  "name": "earth-interactive",
  "version": "0.4.0",
  "description": "An interactive, true-to-scale 3D globe for the browser",
  "type": "module",
  "scripts": {
    "dev": "npx serve . -p 5173",
    "build:data": "node tools/build-data.mjs && node tools/build-ocean.mjs",
    "check": "node tools/check.mjs",
    "build:pages": "node tools/build-pages.mjs dist-pages --with-app",
    "preview:pages": "npm run build:pages && npx serve dist-pages -p 5174",
    "smoke": "node tools/smoke.mjs"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "polygon-clipping": "^0.15.6"
  },
  "engines": {
    "node": ">=18"
  }
}
